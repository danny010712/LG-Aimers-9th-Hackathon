# 대회 원본 데이터 — DACON에서 각자 다운로드 (재배포 하지 않는다)
open/data/
test/data/

# 학습 산출물 — 재생성 가능, 용량만 차지
test/runs/*/model/
test/catboost_info/
test/*.log
test/probe_aux_val2024.csv.gz

# 제출 zip은 모델 바이너리를 품고 있다. 현 최고(012)만 남긴다.
# 나머지는 result.json에 로컬↔LB 대응이 남아 있고 코드로 재현 가능하다.
test/runs/*/submit*.zip
!test/runs/012_shift_full/submit012.zip

